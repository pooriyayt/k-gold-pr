<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top Grabber Handle -->
    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_btn_black"
        android:backgroundTint="#CBD5E1" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="ویجت کی‌گلد"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:text="انتخاب ۲ تا ۴ ارز برای نمایش در باکس هوم‌اسکرین"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- PREVIEWS CONTAINER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="10dp">

        <!-- 1. Single Card Preview -->
        <LinearLayout
            android:id="@+id/preview_single_container"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:background="@drawable/widget_bg_white"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/preview_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_usd" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end|right"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="US Dollar"
                        android:textColor="#1E293B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/preview_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="USD"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preview_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="+۲.۱۱٪ ↗"
                    android:textColor="#16A34A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/preview_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="۶۱,۳۰۰"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="2dp"
                        android:text="تومان"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Unified Rectangular Card Preview -->
        <LinearLayout
            android:id="@+id/preview_multi_container"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="visible">

            <!-- Row 1 -->
            <LinearLayout
                android:id="@+id/preview_row_1"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal">

                <!-- Slot 1 -->
                <LinearLayout
                    android:id="@+id/prev_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/prev_icon_1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_icon_usd" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="end|right"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/prev_name_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="US Dollar"
                                android:textColor="#0F172A"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/prev_code_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="USD"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/prev_change_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+۲.۱۱٪ ↗"
                        android:textColor="#16A34A"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/prev_price_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="۶۱,۳۰۰"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider V1 -->
                <View
                    android:id="@+id/prev_v_divider_1"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="#F1F5F9" />

                <!-- Slot 2 -->
                <LinearLayout
                    android:id="@+id/prev_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/prev_icon_2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_icon_eur" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="end|right"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/prev_name_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Euro"
                                android:textColor="#0F172A"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/prev_code_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EUR"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/prev_change_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+۲.۰۳٪ ↗"
                        android:textColor="#16A34A"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/prev_price_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="۶۶,۴۰۰"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider Horizontal -->
            <View
                android:id="@+id/preview_h_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#F1F5F9"
                android:visibility="gone" />

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/preview_row_2"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Slot 3 -->
                <LinearLayout
                    android:id="@+id/prev_slot_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/prev_icon_3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_icon_aed" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="end|right"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/prev_name_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="UAE Dirham"
                                android:textColor="#0F172A"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/prev_code_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AED"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/prev_change_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+۲.۱۰٪ ↗"
                        android:textColor="#16A34A"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/prev_price_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="۱۶,۶۸۰"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider V2 -->
                <View
                    android:id="@+id/prev_v_divider_2"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="#F1F5F9" />

                <!-- Slot 4 -->
                <LinearLayout
                    android:id="@+id/prev_slot_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/prev_icon_4"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_icon_gbp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="end|right"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/prev_name_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="British Pound"
                                android:textColor="#0F172A"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/prev_code_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GBP"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/prev_change_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+۱.۹۵٪ ↗"
                        android:textColor="#16A34A"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/prev_price_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="۷۸,۲۰۰"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Settings Option: Digits & Language Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_card_mini_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right|end"
            android:text="زبان و فرمت ارزها:"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Segmented Capsule Switcher -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_segmented_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btn_digits_fa"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/widget_pill_active"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="فارسی (۱۲۳)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_digits_en"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="English (123)"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Selection Instructions & Counter -->
    <TextView
        android:id="@+id/txt_selection_counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="انتخاب ارزها (حداقل ۱ و حداکثر ۴):"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Compact 3-Column Asset Chips Grid -->
    <GridView
        android:id="@+id/assets_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:horizontalSpacing="6dp"
        android:verticalSpacing="6dp"
        android:stretchMode="columnWidth"
        android:gravity="center"
        android:listSelector="@android:color/transparent" />

    <!-- Bottom Add Widget Button (Clean Pill with Margins) -->
    <Button
        android:id="@+id/btn_add_widget"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_btn_black"
        android:elevation="4dp"
        android:stateListAnimator="@null"
        android:text="✚ تأیید و افزودن ویجت"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
