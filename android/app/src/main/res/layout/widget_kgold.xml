<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Live Pulse on Left, Golden Brand on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="● نرخ زنده"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right|end"
            android:text="⚡ KGold | کی‌گلد"
            android:textColor="#F59E0B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2x2 Financial Cards Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Dollar Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="دلار آمریکا"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_icon_usd"
                    android:gravity="center"
                    android:text="$"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="تومان"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_usd_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۲۵۶,۵۰۰"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gold 18k Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="طلای ۱۸ عیار"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_icon_gold"
                    android:gravity="center"
                    android:text="18"
                    android:textColor="#F59E0B"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="تومان"
                    android:textColor="#D97706"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_gold_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۲۵,۳۵۸,۰۰۰"
                    android:textColor="#FBBF24"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Tether USDT Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تتر (USDT)"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_icon_usdt"
                    android:gravity="center"
                    android:text="₮"
                    android:textColor="#14B8A6"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="تومان"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_usdt_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۲۵۴,۱۱۶"
                    android:textColor="#34D399"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Emami Coin Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سکه امامی"
                    android:textColor="#CBD5E1"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_icon_coin"
                    android:gravity="center"
                    android:text="🪙"
                    android:textColor="#EAB308"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="تومان"
                    android:textColor="#D97706"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_coin_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۲۵۹,۰۰۵,۰۰۰"
                    android:textColor="#F59E0B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
