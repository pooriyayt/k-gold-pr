<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_white"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Flag/Asset Icon on Left, Name & Code on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- Flag / Asset Icon on Left -->
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_flag_usa" />

        <!-- Title & Code on Right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="end|right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="دلار آمریکا"
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/widget_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="USD"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer to push prices to the bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Area: Previous Price & Large Live Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|left"
            android:orientation="vertical">

            <!-- Previous Price (Small Gray) -->
            <TextView
                android:id="@+id/widget_prev_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۶۱,۲۰۰"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />

            <!-- Main Price (Large Bold Green) -->
            <TextView
                android:id="@+id/widget_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="۶۱,۳۰۰"
                android:textColor="#16A34A"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Currency Unit on Right -->
        <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="3dp"
            android:text="تومان"
            android:textColor="#94A3B8"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
